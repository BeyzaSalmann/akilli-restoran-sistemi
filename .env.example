# Duygu analiz sunucusu (Python)
EMOTION_HOST=0.0.0.0
EMOTION_SERVER_PORT=9999
EMOTION_MODEL_PATH=final_stable_model.h5

# Masaüstü uygulaması (Java) — duygu sunucusuna bağlanır
EMOTION_SERVER_HOST=localhost

# SQLite JDBC adresi (Java çalışma dizinine göre)
DB_URL=jdbc:sqlite:restoran.db

# İsteğe bağlı Flask kamera API'si
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CAMERA_API_URL=http://localhost:5000/predict
FACE_PROTOTXT=deploy.prototxt.txt
FACE_CAFFE_MODEL=res10_300x300_ssd_iter_140000.caffemodel
PYTHON_COMMAND=python3

# Kamera: boş bırakınca iPhone Continuity Camera atlanır, Mac kamerası seçilir.
# Belirli bir indeks zorlamak için örn. CAMERA_INDEX=1
# CAMERA_INDEX=
# CAMERA_NAME=FaceTime HD Kamera

# Mobil API (FastAPI)
ARS_API_HOST=0.0.0.0
